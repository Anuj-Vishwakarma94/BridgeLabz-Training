-- ============================================
-- VISIT MANAGEMENT & MEDICAL RECORDS
-- ============================================

USE sqlpractice;

-- Output:
-- Database changed


-- ============================================
-- STEP 1: CREATE VISITS TABLE
-- ============================================

CREATE TABLE IF NOT EXISTS visits (
    visit_id INT AUTO_INCREMENT PRIMARY KEY,
    appointment_id INT,
    patient_id INT,
    doctor_id INT,
    visit_date DATE DEFAULT CURRENT_DATE,
    diagnosis VARCHAR(255),
    notes TEXT,

    FOREIGN KEY (appointment_id)
    REFERENCES appointments(appointment_id),

    FOREIGN KEY (patient_id)
    REFERENCES patients(patient_id),

    FOREIGN KEY (doctor_id)
    REFERENCES doctors(doctor_id)
);

-- Output:
-- Query OK, 0 rows affected


-- ============================================
-- STEP 2: CREATE PRESCRIPTIONS TABLE
-- ============================================

CREATE TABLE IF NOT EXISTS prescriptions (
    prescription_id INT AUTO_INCREMENT PRIMARY KEY,
    visit_id INT,
    medicine_name VARCHAR(100),
    dosage VARCHAR(50),
    duration VARCHAR(50),

    FOREIGN KEY (visit_id)
    REFERENCES visits(visit_id)
);

-- Output:
-- Query OK, 0 rows affected


-- ============================================
-- UC-4.1 RECORD PATIENT VISIT
-- ============================================

START TRANSACTION;

INSERT INTO visits
(appointment_id, patient_id, doctor_id, visit_date, diagnosis, notes)
VALUES
(4, 1, 3, CURDATE(), 'Hypertension', 'Patient advised lifestyle changes');

UPDATE appointments
SET status = 'COMPLETED'
WHERE appointment_id = 4;

COMMIT;

-- Output:
-- Query OK, 1 row affected
-- Query OK, 0 rows affected (already completed)
-- Commit complete


-- ============================================
-- VERIFY VISITS TABLE
-- ============================================

SELECT * FROM visits;

-- Output:
-- +----------+----------------+------------+-----------+------------+--------------+-----------------------------------+
-- | visit_id | appointment_id | patient_id | doctor_id | visit_date | diagnosis    | notes                             |
-- +----------+----------------+------------+-----------+------------+--------------+-----------------------------------+
-- | 4        | 4              | 1          | 3         | 2026-02-16 | Hypertension | Patient advised lifestyle changes |
-- | 5        | 4              | 1          | 3         | 2026-02-16 | Hypertension | Patient advised lifestyle changes |
-- +----------+----------------+------------+-----------+------------+--------------+-----------------------------------+


-- ============================================
-- UC-4.3 ADD PRESCRIPTIONS
-- ============================================

INSERT INTO prescriptions
(visit_id, medicine_name, dosage, duration)
VALUES
(5, 'Amlodipine', '5 mg once daily', '30 days'),
(5, 'Losartan', '50 mg once daily', '30 days');

-- Output:
-- Query OK, 2 rows affected


-- ============================================
-- ADD MORE PRESCRIPTIONS USING AUTO VISIT_ID
-- ============================================

INSERT INTO prescriptions
(visit_id, medicine_name, dosage, duration)
VALUES
((SELECT MAX(visit_id) FROM visits), 'Amlodipine', '5 mg once daily', '30 days'),
((SELECT MAX(visit_id) FROM visits), 'Losartan', '50 mg once daily', '30 days');

-- Output:
-- Query OK, 2 rows affected


-- ============================================
-- VERIFY PRESCRIPTIONS TABLE
-- ============================================

SELECT * FROM prescriptions;

-- Output:
-- +-----------------+----------+---------------+------------------+----------+
-- | prescription_id | visit_id | medicine_name | dosage           | duration |
-- +-----------------+----------+---------------+------------------+----------+
-- | 6               | 5        | Amlodipine    | 5 mg once daily  | 30 days  |
-- | 7               | 5        | Losartan      | 50 mg once daily | 30 days  |
-- | 8               | 5        | Amlodipine    | 5 mg once daily  | 30 days  |
-- | 9               | 5        | Losartan      | 50 mg once daily | 30 days  |
-- +-----------------+----------+---------------+------------------+----------+


-- ============================================
-- UC-4.2 VIEW PATIENT MEDICAL HISTORY
-- ============================================

SELECT
v.visit_id,
v.visit_date,
v.diagnosis,
p.medicine_name,
p.dosage,
p.duration,
d.doctor_name
FROM visits v
JOIN prescriptions p
ON v.visit_id = p.visit_id
JOIN doctors d
ON v.doctor_id = d.doctor_id
WHERE v.patient_id = 1
ORDER BY v.visit_date DESC;

-- Output:
-- +----------+------------+--------------+---------------+------------------+----------+-------------+
-- | visit_id | visit_date | diagnosis    | medicine_name | dosage           | duration | doctor_name |
-- +----------+------------+--------------+---------------+------------------+----------+-------------+
-- | 5        | 2026-02-16 | Hypertension | Amlodipine    | 5 mg once daily  | 30 days  | Dr. Sharma  |
-- | 5        | 2026-02-16 | Hypertension | Losartan      | 50 mg once daily | 30 days  | Dr. Sharma  |
-- +----------+------------+--------------+---------------+------------------+----------+-------------+


-- ============================================
-- END OF VISIT MANAGEMENT DATABASE FILE
