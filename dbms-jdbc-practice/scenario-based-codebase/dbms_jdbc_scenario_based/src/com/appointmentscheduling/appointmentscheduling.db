-- ============================================
-- APPOINTMENT SCHEDULING SYSTEM 
-- ============================================


-- ============================================
-- STEP 1: CREATE DATABASE
-- ============================================

CREATE DATABASE IF NOT EXISTS appointment_system;

-- Output:
-- Query OK, 1 row affected (if not exists)

USE appointment_system;

-- Output:
-- Database changed



-- ============================================
-- STEP 2: CREATE SPECIALTIES TABLE
-- ============================================

CREATE TABLE specialties (
    specialty_id INT AUTO_INCREMENT PRIMARY KEY,
    specialty_name VARCHAR(100) UNIQUE NOT NULL
);

-- Output:
-- Query OK, 0 rows affected



-- ============================================
-- STEP 3: CREATE DOCTORS TABLE
-- ============================================

CREATE TABLE doctors (
    doctor_id INT AUTO_INCREMENT PRIMARY KEY,
    doctor_name VARCHAR(100) NOT NULL,
    specialization VARCHAR(100),
    contact VARCHAR(15) UNIQUE,
    consultation_fee DECIMAL(10,2),
    specialty_id INT,
    is_active BOOLEAN DEFAULT TRUE,
    max_daily_slots INT DEFAULT 10,

    FOREIGN KEY (specialty_id)
    REFERENCES specialties(specialty_id)
);

-- Output:
-- Query OK, 0 rows affected



-- ============================================
-- STEP 4: CREATE PATIENTS TABLE
-- ============================================

CREATE TABLE patients (
    patient_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    dob DATE,
    phone VARCHAR(15) UNIQUE,
    email VARCHAR(100) UNIQUE,
    address VARCHAR(255),
    blood_group VARCHAR(5)
);

-- Output:
-- Query OK, 0 rows affected



-- ============================================
-- STEP 5: CREATE DOCTOR SCHEDULE TABLE
-- ============================================

CREATE TABLE doctor_schedule (
    schedule_id INT AUTO_INCREMENT PRIMARY KEY,
    doctor_id INT,
    available_day VARCHAR(20),
    available_time VARCHAR(50),

    FOREIGN KEY (doctor_id)
    REFERENCES doctors(doctor_id)
);

-- Output:
-- Query OK, 0 rows affected



-- ============================================
-- STEP 6: CREATE APPOINTMENTS TABLE
-- ============================================

CREATE TABLE appointments (
    appointment_id INT AUTO_INCREMENT PRIMARY KEY,
    patient_id INT,
    doctor_id INT,
    appointment_date DATE,
    appointment_time TIME,
    status VARCHAR(20) DEFAULT 'SCHEDULED',

    FOREIGN KEY (patient_id)
    REFERENCES patients(patient_id),

    FOREIGN KEY (doctor_id)
    REFERENCES doctors(doctor_id)
);

-- Output:
-- Query OK, 0 rows affected



-- ============================================
-- STEP 7: CREATE APPOINTMENT AUDIT TABLE
-- ============================================

CREATE TABLE appointment_audit (
    audit_id INT AUTO_INCREMENT PRIMARY KEY,
    appointment_id INT,
    action VARCHAR(50),
    action_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (appointment_id)
    REFERENCES appointments(appointment_id)
);

-- Output:
-- Query OK, 0 rows affected



-- ============================================
-- STEP 8: INSERT SPECIALTIES
-- ============================================

INSERT INTO specialties (specialty_name)
VALUES
('Cardiologist'),
('Dermatologist'),
('Neurologist'),
('Orthopedic');

-- Output:
-- Query OK, 4 rows affected



-- ============================================
