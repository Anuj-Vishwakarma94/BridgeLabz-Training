(doctor_name, specialization, contact, consultation_fee, specialty_id, max_daily_slots)
VALUES
('Dr. Sharma','Cardiology','9876500001',800.00,1,10),
('Dr. Mehta','Dermatology','9876500002',600.00,2,8);

-- Output:
-- Query OK, 2 rows affected



-- ============================================
-- STEP 10: INSERT PATIENTS
-- ============================================

INSERT INTO patients
(name, dob, phone, email, address, blood_group)
VALUES
('Anuj Vishwakarma','2004-07-28','9999999999','anuj@email.com','Indore','O+'),
('Aryan Sharma','2002-08-15','9123456789','aryan@email.com','Delhi','A+');

-- Output:
-- Query OK, 2 rows affected



-- ============================================
-- STEP 11: INSERT DOCTOR SCHEDULE
-- ============================================

INSERT INTO doctor_schedule
(doctor_id, available_day, available_time)
VALUES
(1,'Monday','10:00 AM - 2:00 PM'),
(1,'Wednesday','10:00 AM - 2:00 PM'),
(2,'Tuesday','11:00 AM - 3:00 PM');

-- Output:
-- Query OK, 3 rows affected



-- ============================================
-- STEP 12: BOOK APPOINTMENT
-- ============================================

INSERT INTO appointments
(patient_id, doctor_id, appointment_date, appointment_time, status)
VALUES
(1,1,'2026-02-16','10:30:00','SCHEDULED');

-- Output:
-- Query OK, 1 row affected



-- ============================================
-- STEP 13: CHECK DOCTOR AVAILABILITY
-- ============================================

SELECT appointment_time, COUNT(*) AS booked_slots
FROM appointments
WHERE doctor_id = 1
AND appointment_date = '2026-02-16'
AND status = 'SCHEDULED'
GROUP BY appointment_time;

-- Output:
-- +------------------+--------------+
-- | appointment_time | booked_slots |
-- +------------------+--------------+
-- | 10:30:00         | 1            |
-- +------------------+--------------+



-- ============================================
-- STEP 14: VIEW DAILY APPOINTMENT SCHEDULE
-- ============================================

SELECT
a.appointment_id,
p.name AS patient_name,
d.doctor_name,
d.specialization,
a.appointment_date,
a.appointment_time,
a.status
FROM appointments a
JOIN patients p ON a.patient_id = p.patient_id
JOIN doctors d ON a.doctor_id = d.doctor_id
ORDER BY a.appointment_time;

-- Output:
-- +----------------+------------------+-------------+----------------+------------------+------------------+-----------+
-- | appointment_id | patient_name     | doctor_name | specialization | appointment_date | appointment_time | status    |
-- +----------------+------------------+-------------+----------------+------------------+------------------+-----------+
-- | 1              | Anuj Vishwakarma | Dr. Sharma  | Cardiology     | 2026-02-16       | 10:30:00         | SCHEDULED |
-- +----------------+------------------+-------------+----------------+------------------+------------------+-----------+



-- ============================================
-- END OF DATABASE FILE
-- ============================================
